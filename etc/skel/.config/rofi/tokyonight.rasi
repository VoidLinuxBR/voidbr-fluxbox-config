/* ============================================================
 * Rofi - Tema Tokyo Night (drun / run / power-menu)
 * ============================================================ */

* {
    bg:       #1a1b26e6; /* com alpha, combina com o blur do picom */
    bg-alt:   #24283bee;
    fg:       #c0caf5;
    fg-alt:   #565f89;
    blue:     #7aa2f7;
    purple:   #bb9af7;
    cyan:     #7dcfff;
    red:      #f7768e;
    border:   #414868;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    background-color: @bg;
    border: 2px;
    border-color: @blue;
    border-radius: 14px;
    padding: 14px;
    width: 32%;
    location: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: @bg-alt;
    text-color: @fg;
    border-radius: 10px;
    padding: 10px 14px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @purple;
    padding: 0 8px 0 0;
}

entry {
    placeholder: "Buscar...";
    placeholder-color: @fg-alt;
}

listview {
    background-color: transparent;
    lines: 8;
    spacing: 6px;
    scrollbar: false;
    fixed-height: false;
}

element {
    background-color: transparent;
    text-color: @fg;
    padding: 8px 10px;
    border-radius: 8px;
}

element selected {
    background-color: @blue;
    text-color: #1a1b26;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 22px;
    padding: 0 8px 0 0;
}
