#!/bin/sh
# ~/.fluxbox/startup - inicia todo o "rice" Tokyo Night

# Áudio (Void não sobe isso sozinho sem systemd --user)
pipewire &
pipewire-pulse &

# Compositor (blur, transparência, sombras, cantos arredondados)
picom --config ~/.config/picom/picom.conf &

# Wallpaper (troca a cada 60s, começa com um fixo)
voidbr-change-wallpaper "/usr/share/backgrounds/voidbr/fluxbox-tokyoight-voidbr.jpg" &

# Daemon de notificações estilizado
dunst -config ~/.config/dunst/dunstrc &

# Bar moderna (substitui a toolbar nativa do fluxbox)
~/.config/polybar/launch.sh &

# Applet de rede/bluetooth/bateria (opcional, se tiver instalado)
nm-applet &
blueman-applet &

# xrdb / cursor (ajuste se necessário)
xsetroot -cursor_name left_ptr &

exec fluxbox
