#!/usr/bin/env python3
import gettext
import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gdk

APPNAME = "voidbr-shortcuts"
LOCALEDIR = "/usr/share/locale"

gettext.bindtextdomain(APPNAME, LOCALEDIR)
gettext.textdomain(APPNAME)
_ = gettext.gettext

SHORTCUTS = [
    (_("Geral"), [
        ("Super + Enter", _("Abrir terminal")),
        ("Super + D", _("Abrir lançador de aplicativos (rofi)")),
        ("Super + Shift + D", _("Abrir lançador de comandos (rofi run)")),
        ("Super + E", _("Abrir gerenciador de arquivos")),
        ("Super + B", _("Abrir navegador")),
        ("Super + L", _("Bloquear tela")),
        ("Super + Shift + R", _("Recarregar configuração do Fluxbox")),
        ("Super + Shift + E", _("Menu de energia (desligar/reiniciar/logout)")),
        ("Super + Shift + Escape", _("Encerrar processo em foco (xkill)")),
        ("Print", _("Capturar tela")),
    ]),
    (_("Janelas"), [
        ("Super + Q", _("Fechar janela em foco")),
        ("Super + Shift + Q", _("Matar janela em foco (kill)")),
        ("Super + F", _("Tela cheia")),
        ("Super + Shift + F", _("Maximizar janela")),
        ("Super + T", _("Alternar decorações da janela")),
        ("Super + Space", _("Próxima janela")),
        ("Super + Shift + Space", _("Janela anterior")),
        ("Super + Tab", _("Alternar entre janelas")),
        ("Super + Shift + Tab", _("Alternar entre janelas (ordem inversa)")),
    ]),
    (_("Encaixe de Janelas"), [
        ("Super + ←", _("Encaixar na metade esquerda")),
        ("Super + →", _("Encaixar na metade direita")),
        ("Super + ↑", _("Encaixar na metade superior")),
        ("Super + ↓", _("Encaixar na metade inferior")),
    ]),
    (_("Áreas de Trabalho"), [
        ("Super + 1..5", _("Alternar área de trabalho")),
        ("Super + Shift + 1..5", _("Mover janela para a área de trabalho")),
        ("Super + Ctrl + →", _("Próxima área de trabalho")),
        ("Super + Ctrl + ←", _("Área de trabalho anterior")),
    ]),
    (_("Multimídia"), [
        ("XF86AudioRaiseVolume", _("Aumentar volume")),
        ("XF86AudioLowerVolume", _("Diminuir volume")),
        ("XF86AudioMute", _("Ativar/Desativar mudo")),
        ("XF86MonBrightnessUp", _("Aumentar brilho")),
        ("XF86MonBrightnessDown", _("Diminuir brilho")),
    ]),
    (_("Mouse"), [
        ("Clique esquerdo no desktop", _("Menu de aplicativos (root menu)")),
        ("Clique direito no desktop", _("Menu de janelas/workspace")),
        ("Alt + Arrastar (botão esquerdo)", _("Mover janela")),
        ("Alt + Arrastar (botão direito)", _("Redimensionar janela")),
        ("Scroll no desktop", _("Alternar área de trabalho")),
        ("Duplo clique na barra de título", _("Enrolar/desenrolar janela (shade)")),
    ]),
    (_("VoidBR"), [
        ("Super + F1", _("Atalhos do VoidBR Fluxbox")),
    ]),
]

CSS = b"""
window { background:#1a1b26; }
headerbar { background:#24283b; }
.title { font-size:18px; font-weight:bold; color:#c0caf5; }
.key { font-family:Monospace; font-weight:bold; color:#7aa2f7; }
.desc { color:#c0caf5; }
.section { font-weight:bold; color:#bb9af7; margin-top:6px; margin-bottom:2px; }
list row { padding:0; }
entry { background:#24283b; color:#c0caf5; }
button { background:#24283b; color:#c0caf5; }
"""

class Win(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=_("Atalhos do VoidBR Fluxbox"))
        self.set_default_size(760, 600)
        self.set_resizable(False)

        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        hb = Gtk.HeaderBar()
        title = Gtk.Label(label=_("Atalhos do VoidBR Fluxbox"))
        title.add_css_class("title")
        hb.set_title_widget(title)
        self.set_titlebar(hb)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                       spacing=6,
                       margin_top=10, margin_bottom=10,
                       margin_start=12, margin_end=12)

        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text(_("Pesquisar atalhos..."))
        root.append(self.search)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.rows = []

        self.search.connect("search-changed", self.filter_rows)

        for section, items in SHORTCUTS:
            lbl = Gtk.Label(xalign=0)
            lbl.set_markup(f"<b>{section}</b>")
            lbl.add_css_class("section")
            row = Gtk.ListBoxRow(selectable=False)
            row.set_child(lbl)
            self.listbox.append(row)
            self.rows.append((row, section.lower(), True))

            for key, desc in items:
                h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16,
                            margin_top=1, margin_bottom=1,
                            margin_start=6, margin_end=6)
                k = Gtk.Label(label=key, xalign=0)
                k.add_css_class("key")
                k.set_size_request(300, -1)
                d = Gtk.Label(label=desc, xalign=0)
                d.add_css_class("desc")
                h.append(k)
                h.append(d)
                r = Gtk.ListBoxRow(selectable=False)
                r.set_child(h)
                self.listbox.append(r)
                self.rows.append((r, (key + " " + desc).lower(), False))

        sw = Gtk.ScrolledWindow(vexpand=True)
        sw.set_child(self.listbox)
        root.append(sw)

        btn = Gtk.Button(label=_("Fechar"))
        btn.connect("clicked", lambda *_: self.close())
        root.append(btn)

        self.set_child(root)

        ctrl = Gtk.EventControllerKey()
        ctrl.connect("key-pressed", self.on_key)
        self.add_controller(ctrl)

    def filter_rows(self, entry):
        txt = entry.get_text().lower().strip()
        visible = False
        for row, content, is_section in reversed(self.rows):
            if is_section:
                row.set_visible(visible or txt == "")
                visible = False
            else:
                ok = txt in content
                row.set_visible(ok)
                if ok:
                    visible = True

    def on_key(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.voidbr.shortcuts.fluxbox")

    def do_activate(self):
        Win(self).present()

if __name__ == "__main__":
    App().run()
